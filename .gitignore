.venv/
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
!.env.example
venv/
*.log

# macOS metadata
.DS_Store
**/.DS_Store

# Claude Code local settings — not project config
# ...except the slash commands. They are project tooling with no personal data
# and no secrets, they get edited during development like any other source file,
# and ignoring them has already cost us one: the original troubleshoot command
# existed only in a chat transcript and had to be rebuilt by hand.
# settings.local.json stays ignored — machine-specific paths.
#
# Note the shape: ".claude/" alone cannot be used, because git will not descend
# into an excluded directory and a "!" rule below it never matches. Exclude the
# contents, re-admit the one subdirectory, then its .md files.
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/*.md

# TLS certs — never committed (IP-specific; regenerate with mkcert on each machine)
certs/
certs_backup/

# Android build — Capacitor generated; regenerate with: npx cap add android
android/

# Node dependencies
node_modules/

# Sensitive data — never committed
data/logs/*.json
data/journal/*
data/wisdom/*
data/archive/*
data/memory/*

# Runtime data (sensitive or ephemeral)
data/audio/
data/baselines/
data/config/
data/context.json
data/conversations/
data/push_subscriptions.json
data/voices/

# ---------------------------------------------------------------------------
# REAL USER personas — sensitive tier. Never committed, under any circumstances.
#
# `mike` is a real person's logs, journal, health, finances and memory. This is
# not a "test persona" and never was, though the heading above these lines said
# so until 2026-08-04. There is NO `git add -f` escape hatch here: if something
# in this tree looks like it needs committing, the answer is that it does not.
# Sensitive-tier data does not enter git history — that is the 2026-07-29
# incident, which cost a full history rewrite.
data/personas/mike/

# ---------------------------------------------------------------------------
# ALL OTHER persona data trees — synthetic and dev personas.
#
# This was an enumerated list until 2026-08-04, and the list fell behind:
# pepys, test_a3, sarah_chen and three of ryan_holiday's subdirectories were
# covered, while arthur_brooks, cal_newport, danny_park, maya_torres and
# oliver_burkeman were not. Those five are written to on every validation run
# and a `git add -A` would have committed them. A list that must be updated by
# hand each time a persona is added is the defect, not the missing entries.
#
# The rule that does not drift: no persona data tree is committable by default,
# because the running system writes into all of them and nothing at runtime
# distinguishes a synthetic persona from a real one (persona unification,
# 2026-07-28 — see ROADMAP.md § Binding privacy ruling). The wildcard also
# covers `mike` a second time, which is intended: the explicit rule above is
# there to be read, not because the glob needs help.
#
# Seed fixtures already tracked stay tracked — .gitignore does not untrack.
# A genuinely new *synthetic* fixture needs `git add -f`. Before forcing, check
# which tree you are in: a fixture that silently fails to commit is recoverable,
# a real persona's logs that silently do commit are not.
data/personas/*/

# Real user persona config — sensitive
config/personas/mike.md
config/personas/mike/

# CalDAV credentials — sensitive
config/modules/caldav.yaml

# Session verbatim transcripts — large; source of truth is ~/.claude/projects/*.jsonl
archive/sessions/*.txt
archive/transcripts/

# Per-persona settings (profile, schedule, calendar credentials) — sensitive
config/personas/*/profile.yaml
config/personas/*/scheduler.yaml
config/personas/*/caldav.yaml
# write_config keeps the previous version of prime_directive.md / mission.md
# before overwriting. Tier 1-2 content — sensitive, never committable.
config/personas/*/*.bak

# Pre-reset data archives — user data, never committed
data/_pre_reset_*/

# Diagnostic captures pulled out of live data — may contain real user entries
data/diagnostics/

# Local backups pulled from the VM — real user data, never committed
backups/

# Local convenience file (empty, clicked to reduce editor context noise)
dummy
.dev_backlog_seen
