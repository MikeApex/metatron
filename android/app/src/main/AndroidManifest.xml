<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup is false (WhatsApp plan P4, 2026-10-30): Android's auto-backup would
         otherwise copy app storage to Google Drive — the WhatsApp backup key once it is held
         on the phone, and today already the WebView's localStorage with the session token.
         The key is also kept in no_backup/, which auto-backup never copies; this is the
         second lock, not the only one. -->
    <!-- android:name: MetatronApp sweeps the WhatsApp read's work folder at every process start
         (WhatsApp Phase 2 plan § 3.1), so a run killed after its decrypt leaves nothing behind. -->
    <application
        android:name=".MetatronApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the media session that receives the headset button, for exactly as
             long as headset mode is armed.

             The `microphone` half of foregroundServiceType is not optional and not
             cosmetic: Android 11+ silences mic capture for an app that is not in the
             foreground unless a foreground service of that type holds it. With only
             mediaPlayback declared, a press with the screen locked records silence and
             the client files it as "No speech detected" — a clean-looking no-op on the
             exact case the feature exists for, while every foreground test passes.

             `stopWithTask` is false so onTaskRemoved runs and can disarm deliberately;
             see MetatronHeadsetService. -->
        <service
            android:name=".MetatronHeadsetService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback|microphone" />

        <!-- Day planner Stage C: the VM's FCM ping, received with the app closed. The ping is
             data-only and carries a message id; this service fetches the text from the VM and
             shows the notification. Not exported: only Google Play services delivers to it. -->
        <service
            android:name=".MetatronMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Done / Not yet / Skipped and "remind me in …" on those notifications. Not
             exported: only this app's own PendingIntents reach it. -->
        <receiver
            android:name=".PushActionReceiver"
            android:exported="false" />

        <!-- What the Firebase library may tell Google, pinned rather than left to defaults
             (read from firebase-messaging 25.0.0's MessagingAnalytics, 2026-10-28):
             - no push token, and so no installation registered with Google, until the page
               hands over a sign-in (MainActivity.setPushAuth calls getToken explicitly);
             - no delivery events through the datatransport pipe — off by default, and this
               keeps it off if a later library flips that default;
             - no Analytics: the library is not in the APK; this stays true if it ever is. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="delivery_metrics_exported_to_big_query_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />

        <!-- WhatsApp link (Phase 2 plan § 3.12, decision 1: one APK for every user, switched on
             by consent). Everything below is declared for everyone and active for nobody until
             the VM says that user's WhatsApp consent is recorded — whatsapp/Gate.java is the
             runtime gate, and the VM's consent gate refuses every /device/whatsapp/* call as
             the second check.

             The screen: pairing, the key, the grants. Not exported — opened only from the page's
             "WhatsApp link" entry (MainActivity.openWhatsApp) and this app's own notices. -->
        <activity
            android:name=".whatsapp.WhatsAppActivity"
            android:label="WhatsApp link"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- "Choose chats" (§ 3.9). Not exported: reached only from the WhatsApp screen. -->
        <activity
            android:name=".whatsapp.ShareListActivity"
            android:label="Choose chats"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- The nightly backup read (§ 3.2). Only JobScheduler binds to it. -->
        <service
            android:name=".whatsapp.NightlyJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- After a reboot, makes sure the nightly job is scheduled (§ 3.2) — only when the gate
             and the user's grants allow one. Not exported: only the system's BOOT_COMPLETED. -->
        <receiver
            android:name=".whatsapp.WaBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The live feed (§ 3.10). enabled="false" is the point: a listener the manifest
             enables would sit in the notification-access list for every user, consented or not.
             Gate enables it only while the channel is open and disables it on any 403, a 401 or
             "Turn off". Only the system binds to it (it alone holds the permission below). -->
        <service
            android:name=".whatsapp.WaListener"
            android:label="Metatron WhatsApp link"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- "Should have come up" (§ 3.11): WhatsApp → long-press a message → Share → Metatron.
             Exported because a share target must be; enabled="false" so it is in no one's share
             sheet until Gate turns it on with the listener. -->
        <activity
            android:name=".whatsapp.MissedShareActivity"
            android:label="Should have come up"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- navigator.vibrate() in the WebView is inert without this. Normal-tier, so it
         is granted at install with no runtime request. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- navigator.geolocation in the WebView is refused by the OS without these, and
         refused *silently*: the app never sees a prompt, so the failure reads as "could
         not get a location fix" and looks like a GPS problem. Found 2026-09-03 by the
         first real ping [DB-0815-12] — the 11 passing JS tests run in a browser, where
         geolocation needs no manifest, so nothing exercised this layer.
         Dangerous-tier, so declaring them is necessary and not sufficient: Android 6+
         also requires a runtime grant. Both are declared because a coarse-only grant
         still satisfies zone resolution (circles are 100m+), and asking for fine alone
         would make a coarse answer a refusal. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Headset mode. MICROPHONE is the one that decides whether the feature works at
         all: without it the foreground service cannot hold a microphone-typed capture,
         and Android 11+ then records silence whenever the app is not in front — which
         the client reports as "No speech detected", indistinguishable from a mis-press
         without listening to the stored .webm.

         POST_NOTIFICATIONS is dangerous-tier on Android 13+, so declaring it is
         necessary and not sufficient; MainActivity requests it at runtime. Without the
         grant the service runs invisibly, holding the media button with nothing on
         screen to say so. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WhatsApp link (Phase 2 plan § 3.12). Declared for everyone, asked for from no one until
         the VM reports that user's consent — and then only at their own tap on the WhatsApp
         screen (whatsapp/WhatsAppActivity.java).

         MANAGE_EXTERNAL_STORAGE reads WhatsApp's backups in Android/media/com.whatsapp/ from
         another app. Special access: granted in Settings, never at install, never by a dialog.
         READ_EXTERNAL_STORAGE covers Android ≤ 12 (13 removed it); the screen asks for it only
         on Android 10 and below, which have no All-files access.
         READ_CONTACTS names one-to-one chats by the user's own contact names (§ 3.9);
         dangerous-tier, runtime-requested.
         RECEIVE_BOOT_COMPLETED keeps the nightly job across a reboot (§ 3.2); normal tier. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (Android 11+): whether WhatsApp is installed, and its version —
         the backup format can change with any update. -->
    <queries>
        <package android:name="com.whatsapp" />
    </queries>
</manifest>
