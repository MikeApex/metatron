<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the media session that receives the headset button, for exactly as
             long as headset mode is armed.

             The `microphone` half of foregroundServiceType is not optional and not
             cosmetic: Android 11+ silences mic capture for an app that is not in the
             foreground unless a foreground service of that type holds it. With only
             mediaPlayback declared, a press with the screen locked records silence and
             the client files it as "No speech detected" — a clean-looking no-op on the
             exact case the feature exists for, while every foreground test passes.

             `stopWithTask` is false so onTaskRemoved runs and can disarm deliberately;
             see MetatronHeadsetService. -->
        <service
            android:name=".MetatronHeadsetService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback|microphone" />

        <!-- Day planner Stage C: the VM's FCM ping, received with the app closed. The ping is
             data-only and carries a message id; this service fetches the text from the VM and
             shows the notification. Not exported: only Google Play services delivers to it. -->
        <service
            android:name=".MetatronMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Done / Not yet / Skipped and "remind me in …" on those notifications. Not
             exported: only this app's own PendingIntents reach it. -->
        <receiver
            android:name=".PushActionReceiver"
            android:exported="false" />

        <!-- What the Firebase library may tell Google, pinned rather than left to defaults
             (read from firebase-messaging 25.0.0's MessagingAnalytics, 2026-10-28):
             - no push token, and so no installation registered with Google, until the page
               hands over a sign-in (MainActivity.setPushAuth calls getToken explicitly);
             - no delivery events through the datatransport pipe — off by default, and this
               keeps it off if a later library flips that default;
             - no Analytics: the library is not in the APK; this stays true if it ever is. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="delivery_metrics_exported_to_big_query_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- navigator.vibrate() in the WebView is inert without this. Normal-tier, so it
         is granted at install with no runtime request. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- navigator.geolocation in the WebView is refused by the OS without these, and
         refused *silently*: the app never sees a prompt, so the failure reads as "could
         not get a location fix" and looks like a GPS problem. Found 2026-09-03 by the
         first real ping [DB-0815-12] — the 11 passing JS tests run in a browser, where
         geolocation needs no manifest, so nothing exercised this layer.
         Dangerous-tier, so declaring them is necessary and not sufficient: Android 6+
         also requires a runtime grant. Both are declared because a coarse-only grant
         still satisfies zone resolution (circles are 100m+), and asking for fine alone
         would make a coarse answer a refusal. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Headset mode. MICROPHONE is the one that decides whether the feature works at
         all: without it the foreground service cannot hold a microphone-typed capture,
         and Android 11+ then records silence whenever the app is not in front — which
         the client reports as "No speech detected", indistinguishable from a mis-press
         without listening to the stored .webm.

         POST_NOTIFICATIONS is dangerous-tier on Android 13+, so declaring it is
         necessary and not sufficient; MainActivity requests it at runtime. Without the
         grant the service runs invisibly, holding the media button with nothing on
         screen to say so. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
