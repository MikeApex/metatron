<?xml version="1.0" encoding="utf-8" ?>
<!-- WhatsApp probe screen — merged into the `waprobe` build type ONLY: waprobe = debug + this
     screen and its listener (Phase 2 plan § 3.12). Mike's re-measuring build; nobody else's
     phone gets it. The All-files and storage permissions and WhatsApp's package visibility
     moved to the main manifest with Phase 2 (decision 1: one APK for every user, switched on
     by consent), so moving between `debug` and `waprobe` keeps All-files access. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (Android 11+): whether AICore is installed, for checkpoint LM.
         WhatsApp's own entry is in the main manifest now. -->
    <queries>
        <package android:name="com.google.android.aicore" />
    </queries>

    <application>
        <activity
            android:name="com.mike.metatron.whatsapp.ProbeActivity"
            android:label="WA probe"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault"
            android:taskAffinity="com.mike.metatron.waprobe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system binds to it (the permission below is held by the system alone). -->
        <service
            android:name="com.mike.metatron.whatsapp.ProbeListener"
            android:label="Metatron WhatsApp probe"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
