[Unit]
Description=Daily check of the Metatron TLS certificate

[Timer]
# Daily at 04:30 with jitter. Daily because the cost of a no-op run is nil and the
# cost of a missed window is a total, silent outage; 04:30 because the one run in
# ~90 that does renew ends in a server restart.
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
